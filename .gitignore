/target
**/*.rs.bk
.DS_Store
# Ham, indirilen veri depoya girmez; yalnızca data/SOURCES.toml ve küçük işlenmiş dosyalar.
/data/raw/

# CJK yazı tipleri büyük; scripts/fetch_fonts.py ile indirilir.
/assets/fonts/cjk/*.otf

# Üretilmiş harita verisi: scripts/prepare_data.py ile yeniden üretilir.
/data/map/

# Tek seferlik veri üretimi araçları (ObsPy vb.)
/.venv/

# Üretilmiş Vs30 rasterı (~150 MB): scripts/prepare_data.py ile.
/data/vs30/

# Faz 7 girdi katmanları (~yüzlerce MB): seismira-data ground-inputs ile.
/data/ground/

# Faz 8 tsunami verisi (bathy 25 MB, kıyı 2 MB): scripts/prepare_data.py ile.
/data/tsunami/

# GEM paketi (CC BY-NC-SA 4.0; ayrı paket, ticari kullanım yok): scripts/prepare_data.py --gem.
/data/gem/

__pycache__/

# Paketleme çıktısı (scripts/package_data.py, sürüm arşivleri).
/dist/

# Kritik tesisler (OSM, ODbL): scripts/gen_infra.py + seismira-data infra ile üretilir.
/data/infra/
